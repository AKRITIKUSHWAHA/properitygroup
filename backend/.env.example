# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Connection (Prisma ORM)
DATABASE_URL="mysql://root:@localhost:3306/njs_db"

# JWT Authentication
JWT_SECRET="njs_property_group_jwt_secret_key_2026_dev_secure"
JWT_EXPIRES_IN="7d"

# Allowed Frontend URLs for CORS
CLIENT_URL="http://localhost:5175,http://localhost:5173"

# ==========================================
# Third-Party APIs (Client Keys)
# ==========================================

# 1. Stripe UK (Payments & Invoices)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# 2. Resend (Email Notifications: Proposals, Invoices, Signed Terms)
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_..."
EMAIL_FROM="NJS Property Group <operations@njspropertygroup.co.uk>"

# 3. UK Postcode & Address Lookup (Ideal Postcodes)
# Get from: https://ideal-postcodes.co.uk/
# Note: If left blank, free postcodes.io automatically provides UK sector validation
IDEAL_POSTCODES_API_KEY="ak_..."

# Optional: Cloud Storage (Only if not using local server /uploads folder)
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
