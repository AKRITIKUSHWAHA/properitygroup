generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  password        String
  role            Role             @default(CUSTOMER)
  phone           String?
  avatar          String?
  status          UserStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  auditLogs       AuditLog[]
  reviews         CustomerReview[]
  clientJobs      Job[]            @relation("ClientJobs")
  assignedJobs    Job[]            @relation("SurveyorJobs")
  messagesSent    Message[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  surveyorProfile SurveyorProfile?

  @@map("users")
}

model SurveyorProfile {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  accreditation    String    @default("MRICS")
  ricsNumber       String?
  piiPolicyNumber  String?
  piiExpiryDate    DateTime?
  piiValidated     Boolean   @default(true)
  postcodesCovered String    @default("SW, W, WC, EC, NW")
  activeLoad       Int       @default(0)
  maxLoad          Int       @default(10)
  rating           Float     @default(4.9)
  available        Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("surveyor_profiles")
}

model Company {
  id                    Int      @id @default(autoincrement())
  name                  String
  branchName            String?
  address               String?
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  referralRate          Float    @default(10)
  totalInstructions     Int      @default(0)
  keyCollectionProtocol String?  @db.Text
  status                String   @default("ACTIVE")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  jobs                  Job[]
  leads                 Lead[]

  @@map("companies")
}

model Lead {
  id              Int            @id @default(autoincrement())
  reference       String         @unique
  clientName      String
  clientEmail     String
  clientPhone     String?
  propertyAddress String
  postcode        String
  serviceType     String         @default("RICS Level 2 Home Survey")
  propertyType    String?
  estimatedValue  Float?
  source          String         @default("WEBSITE")
  status          LeadStatus     @default(NEW)
  companyId       Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  callLogs        CallLog[]
  complaints      ComplaintLog[]
  jobs            Job[]
  company         Company?       @relation(fields: [companyId], references: [id])
  quotes          Quote[]

  @@index([companyId], map: "leads_companyId_fkey")
  @@map("leads")
}

model CallLog {
  id              Int      @id @default(autoincrement())
  leadId          Int?
  jobId           Int?
  callerName      String
  callTime        DateTime @default(now())
  durationMinutes Int?
  summary         String   @db.Text
  handlerName     String
  createdAt       DateTime @default(now())
  job             Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lead            Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([jobId], map: "call_logs_jobId_fkey")
  @@index([leadId], map: "call_logs_leadId_fkey")
  @@map("call_logs")
}

model ComplaintLog {
  id              Int       @id @default(autoincrement())
  leadId          Int?
  jobId           Int?
  title           String
  description     String    @db.Text
  severity        String    @default("MEDIUM")
  status          String    @default("OPEN")
  resolutionNotes String?   @db.Text
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  job             Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lead            Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([jobId], map: "complaint_logs_jobId_fkey")
  @@index([leadId], map: "complaint_logs_leadId_fkey")
  @@map("complaint_logs")
}

model Job {
  id                      Int              @id @default(autoincrement())
  reference               String           @unique
  stage                   JobStage         @default(QUOTE_ISSUED)
  serviceType             String           @default("RICS Level 2 Home Survey")
  propertyAddress         String
  postcode                String
  clientName              String
  clientEmail             String
  clientPhone             String?
  clientId                Int?
  surveyorId              Int?
  leadId                  Int?
  companyId               Int?
  inspectionDate          DateTime?
  inspectionTime          String?
  keyCollectionDetails    String?          @db.Text
  specialInstructions     String?          @db.Text
  estimatedTurnaroundDays Int              @default(5)
  reportPdfUrl            String?
  reportGeneratedAt       DateTime?
  qaApprovedBy            String?
  qaApprovedAt            DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  auditTimeline           AuditLog[]
  callLogs                CallLog[]
  complaints              ComplaintLog[]
  reviews                 CustomerReview[]
  invoices                Invoice[]
  client                  User?            @relation("ClientJobs", fields: [clientId], references: [id])
  company                 Company?         @relation(fields: [companyId], references: [id])
  lead                    Lead?            @relation(fields: [leadId], references: [id])
  surveyor                User?            @relation("SurveyorJobs", fields: [surveyorId], references: [id])
  messages                Message[]
  quotes                  Quote[]
  supportTickets          SupportTicket[]
  terms                   Term[]

  @@index([clientId], map: "jobs_clientId_fkey")
  @@index([companyId], map: "jobs_companyId_fkey")
  @@index([leadId], map: "jobs_leadId_fkey")
  @@index([surveyorId], map: "jobs_surveyorId_fkey")
  @@map("jobs")
}

model Quote {
  id          Int         @id @default(autoincrement())
  reference   String      @unique
  jobId       Int?
  leadId      Int?
  baseFee     Float
  vatRate     Float       @default(20)
  vatAmount   Float
  totalAmount Float
  inclusions  String?     @db.Text
  status      QuoteStatus @default(DRAFT)
  validUntil  DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  job         Job?        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([jobId], map: "quotes_jobId_fkey")
  @@index([leadId], map: "quotes_leadId_fkey")
  @@map("quotes")
}

model Term {
  id              Int       @id @default(autoincrement())
  reference       String    @unique
  jobId           Int
  clientName      String
  clientEmail     String
  documentTitle   String    @default("RICS Standard Terms of Engagement")
  content         String    @db.Text
  signed          Boolean   @default(false)
  signatureData   String?   @db.Text
  signedAt        DateTime?
  signerIp        String?
  signerUserAgent String?
  tamperAuditHash String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// One active (non-superseded) term per job enforced at app-layer in termsAndDocumentsController.
  /// A partial unique index (WHERE documentTitle NOT LIKE '[SUPERSEDED]%') cannot be expressed in
  /// Prisma DSL (MySQL partial indexes are not yet supported by prisma migrate).
  /// App-layer guard: before create, check term.findFirst({ where: { jobId, NOT: { documentTitle: { startsWith: '[SUPERSEDED]' } } } }).
  @@index([jobId], map: "terms_jobId_fkey")
  @@map("terms")
}

model Invoice {
  id                    Int           @id @default(autoincrement())
  invoiceNumber         String        @unique
  jobId                 Int
  clientName            String
  clientEmail           String
  subtotal              Float
  vatAmount             Float
  total                 Float
  status                InvoiceStatus @default(PENDING)
  paymentMethod         String?
  stripePaymentIntentId String?
  stripeReceiptUrl      String?
  bacsReference         String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  job                   Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId], map: "invoices_jobId_fkey")
  @@map("invoices")
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId String
  jobId          Int?
  senderId       Int?
  senderName     String
  role           String   @default("admin")
  content        String   @db.Text
  readByAdmin    Boolean  @default(false)
  readByCustomer Boolean  @default(false)
  createdAt      DateTime @default(now())
  job            Job?     @relation(fields: [jobId], references: [id])
  sender         User?    @relation(fields: [senderId], references: [id])

  @@index([jobId], map: "messages_jobId_fkey")
  @@index([senderId], map: "messages_senderId_fkey")
  @@map("messages")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  jobId     Int?
  userId    Int?
  action    String
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([jobId], map: "audit_logs_jobId_fkey")
  @@index([userId], map: "audit_logs_userId_fkey")
  @@map("audit_logs")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  category  String   @default("GENERAL")
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model CustomerReview {
  id         Int      @id @default(autoincrement())
  userId     Int
  jobId      Int?
  rating     Int      @default(5)
  title      String?
  reviewText String   @db.Text
  platform   String   @default("TRUSTPILOT")
  verified   Boolean  @default(true)
  createdAt  DateTime @default(now())
  job        Job?     @relation(fields: [jobId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId], map: "customer_reviews_jobId_fkey")
  @@index([userId], map: "customer_reviews_userId_fkey")
  @@map("customer_reviews")
}

model SupportTicket {
  id        Int      @id @default(autoincrement())
  ticketNo  String   @unique
  userId    Int
  jobId     Int?
  subject   String
  message   String   @db.Text
  category  String   @default("SURVEY_QUERY")
  status    String   @default("OPEN")
  priority  String   @default("NORMAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job       Job?     @relation(fields: [jobId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId], map: "support_tickets_jobId_fkey")
  @@index([userId], map: "support_tickets_userId_fkey")
  @@map("support_tickets")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  role      Role?
  title     String
  desc      String   @db.Text
  type      String   @default("booking")
  amount    String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "notifications_userId_fkey")
  @@map("notifications")
}

enum Role {
  ADMIN
  SURVEYOR
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum JobStage {
  ENQUIRY
  QUOTE_ISSUED
  QUOTE_ACCEPTED
  TERMS_SIGNED
  PAID
  BOOKED
  INSPECTED
  DRAFTING
  QA_REVIEW
  COMPLETE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTE_SENT
  CONVERTED
  LOST
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}
