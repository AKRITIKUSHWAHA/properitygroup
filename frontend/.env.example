# ==========================================
# Frontend Environment Configuration (Vite)
# ==========================================

# 1. Backend API Base URL
VITE_API_URL=/api/v1

# 2. Application Meta & Branding
VITE_APP_NAME="NJS Property Group - Chartered Surveyors"
VITE_APP_ENV=development

# 3. Stripe UK Publishable Key (Client-side payments)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# 4. Ideal Postcodes API Key (Optional: UK Postcode Address Autocomplete)
VITE_IDEAL_POSTCODES_API_KEY=""
